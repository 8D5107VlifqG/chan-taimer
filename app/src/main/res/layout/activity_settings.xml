<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Настройки"
            android:textSize="28sp" />
        <Switch
            android:id="@+id/swSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="56dp"
            android:text="Звук по окончании" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Звук для пробуждения"
            android:textSize="16sp" />
        <RadioGroup
            android:id="@+id/rgSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прослушать" />
        <TextView
            android:id="@+id/tvPitchMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Тональность основного звука"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/sbPitchMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Громкость"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Switch
            android:id="@+id/swMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="56dp"
            android:text="Громкость мультимедиа (обычные кнопки громкости)" />

        <Switch
            android:id="@+id/swBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Усиление громкости (звук громче, тембр плотнее)" />

        <Switch
            android:id="@+id/swSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Один длинный затухающий звон (вместо серии ударов «динь»)" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Длительность звука, сек (1–60)"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/etSec"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Интервал между ударами «динь», сек (0,5–30)"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/etStrike"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLength="4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Количество сигналов (1–100)"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/etCount"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3" />
        <Switch
            android:id="@+id/swInf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="56dp"
            android:text="Бесконечное количество сигналов (до остановки)" />
        <Switch
            android:id="@+id/swFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="56dp"
            android:text="Другой звук для последнего сигнала" />
        <LinearLayout
            android:id="@+id/finalBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Звук последнего сигнала"
            android:textSize="16sp" />
        <RadioGroup
            android:id="@+id/rgFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnPreviewFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прослушать" />
        <TextView
            android:id="@+id/tvPitchFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Тональность завершающего звука"
            android:textSize="16sp" />
        <SeekBar
            android:id="@+id/sbPitchFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Пауза между сигналами, мин (0,1–60; после окончания звука)"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/etGap"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLength="5" />
        <Switch
            android:id="@+id/swVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="Вибрация вместе со звуком" />
        <Switch
            android:id="@+id/swKeepOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="56dp"
            android:text="Не гасить экран во время таймера" />
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Назад" />
    </LinearLayout>
</ScrollView>
